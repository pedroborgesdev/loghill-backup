APP_HOST=0.0.0.0
APP_PORT=8001
DATA_DIR=./data
MAX_LOG_LINES=100000
LOG_COMPACT_TARGET_LINES=95000
INACTIVE_AFTER=5m
HEALTHCHECK_INTERVAL=1m
COMPACT_KEEP_LINES=2000
DELETE_AFTER=168h
CLEANUP_INTERVAL=1m
MAX_BODY_SIZE=1048576
MAX_MESSAGE_SIZE=262144
MAX_METADATA_SIZE=262144
MAX_PAGE_SIZE=1000
LOG_COUNTS_AS_ACTIVITY=true
# Senha da interface web. Se definida, o login é exigido automaticamente.
APP_PASSWORD=
# Opcional: força auth on/off independentemente de APP_PASSWORD.
# APP_AUTH_ENABLED=true
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
LOG_LEVEL=INFO
TZ=America/Sao_Paulo
SSE_HEARTBEAT_INTERVAL=20s
SSE_CLIENT_BUFFER=100
SSE_MAX_CLIENTS_PER_SENDER=100
SHUTDOWN_TIMEOUT=10s
APP_PUBLIC_URL=http://localhost:8001
EMAIL_PROVIDER=outlook
OUTLOOK_ENABLED=false
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_SENDER_EMAIL=
OUTLOOK_SENDER_NAME=LogHill
# Gmail via SMTP/STARTTLS. Use EMAIL_PROVIDER=gmail para selecionar este provider.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Use uma senha de aplicativo do Google, não a senha normal da conta.
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SENDER_NAME=LogHill
# Opcional. Base64 de 32 bytes. Se vazio/inválido, o servidor gera e persiste em DATA_DIR/email-encryption.key
EMAIL_SETTINGS_ENCRYPTION_KEY=
EMAIL_ALERT_QUEUE_SIZE=1000
EMAIL_ALERT_WORKERS=2
EMAIL_ALERT_SEND_TIMEOUT=30s
EMAIL_ALERT_MAX_RETRIES=3
EMAIL_ALERT_RETRY_INTERVAL=5s

# SMS por Twilio. As credenciais permanecem somente no ambiente.
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Histórico unificado de Alertas, Eventos e Monitoramento
EXECUTION_HISTORY_RETENTION_DAYS=90
EXECUTION_HISTORY_MAX_RECORDS=100000
EXECUTION_HISTORY_CLEANUP_INTERVAL=1h
